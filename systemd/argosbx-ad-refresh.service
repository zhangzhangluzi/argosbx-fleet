[Unit]
Description=Refresh ArgoSBX subscription ad rules
After=network-online.target sub-store.service caddy-sub.service
OnFailure=argosbx-ad-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B /opt/argosbx-fleet/current/ad_monitor.py run
TimeoutStartSec=240
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
